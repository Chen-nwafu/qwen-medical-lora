# ============================================================
# 仓库只保留【文件夹结构】，不含任何模型权重 / 数据文件。
#
# 原理：Git 不记录空目录，所以在目录里放一个 .gitkeep 占位文件。
# 下面每个目录都忽略其内容，但放行 .gitkeep。
# 使用者 clone 后按下文把权重/数据放回对应目录即可。
# ============================================================

# ---- 模型权重目录（0.5B 基座 ~988MB，PiSSA 残差模型 ~988MB）----
qwen2.5_0.5B/**
!qwen2.5_0.5B/.gitkeep
pissa_models/**
!pissa_models/.gitkeep

# ---- 数据集（train_zh_0.json 单文件 1.3GB）----
data/**
!data/.gitkeep

# ---- 训练产出（9 个适配器合计 ~260MB）----
adapter_save/**
!adapter_save/.gitkeep

# ============================================================
# 训练中间产物：整个目录都不保留（连文件夹也不传）
# ============================================================
tmp/

# ============================================================
# 通用权重后缀兜底：防止从其它位置误提交权重
# ============================================================
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.gguf
*.h5
*.msgpack
*.ckpt

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/
.python-version

# ============================================================
# 编辑器 / 系统
# ============================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 日志与缓存
# ============================================================
*.log
.cache/
wandb/
runs/

# ============================================================
# 注意：eval_results/ 故意不忽略
# 里面的 summary.txt / eval_results.json / loss_compare.png 是
# 实验结果（<1MB），是仓库的核心展示内容，需要提交
# ============================================================
